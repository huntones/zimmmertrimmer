{
  "name": "kolkli-send-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KOLKLI SEND — deliveries backend (DB + API + auth + file security). Infrastructure phase; no UI.",
  "engines": { "node": ">=20" },
  "scripts": {
    "migrate": "node src/db/migrate.js up",
    "migrate:status": "node src/db/migrate.js status",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "aws4fetch": "^1.0.20",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "file-type": "^22.0.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  }
}
