# ============================================================
# KOLKLI SEND backend — environment.
# Copy to `.env` for local dev. NEVER commit a real `.env`.
# Everything has a safe local default; you only need to set
# real values when pointing at Supabase / R2 / a real mailer.
# ============================================================

# --- HTTP -----------------------------------------------------
PORT=8787
# Comma-separated allowed origins for CORS, or * for dev.
ALLOWED_ORIGIN=*
# Public base URL of THIS api (used to build local presigned URLs).
PUBLIC_BASE_URL=http://localhost:8787

# --- Database -------------------------------------------------
# Postgres connection string.
#  - Local dev/test: leave blank -> an embedded Postgres is booted.
#  - Supabase (prod): use the *pooler* / direct connection string, e.g.
#    postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Auth (owner endpoints) -----------------------------------
# Owner endpoints require a Bearer JWT. In prod this is the Supabase
# JWT secret (Project Settings -> API -> JWT Secret) so the tokens your
# existing auth-store.js issues are accepted unchanged.
# For local dev/test, any long random string; the test harness mints
# tokens with this same secret.
SUPABASE_JWT_SECRET=dev-only-owner-jwt-secret-change-me-please-32+chars

# --- Public session tokens (client, after password/code verify) --
# HMAC secret for the short-lived tokens handed to a verified client.
# Independent from the owner secret. Any long random string.
PUBLIC_SESSION_SECRET=dev-only-public-session-secret-change-me-please
# Lifetime of a client session token, in minutes.
PUBLIC_SESSION_TTL_MIN=60

# --- Presigned download URLs ----------------------------------
# HMAC secret for local-fs presigned URLs. (R2 uses its own keys.)
PRESIGN_SECRET=dev-only-presign-secret-change-me-please
# How long a presigned download URL is valid, in seconds.
PRESIGN_TTL_SEC=300

# --- Storage --------------------------------------------------
# Driver: `local` (private folder on disk, for dev/test) or `r2`.
STORAGE_DRIVER=local
# local driver: private directory that is NEVER served statically.
STORAGE_LOCAL_DIR=./.storage
# r2 driver (Cloudflare R2, S3-compatible). Set these for prod.
R2_ACCOUNT_ID=
R2_BUCKET=kolkli-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Mail -----------------------------------------------------
# Driver: `console` (logs, captures for tests — sends nothing) or `provider`.
MAIL_DRIVER=console
# provider driver mirrors worker/src/index.js sendEmail().
# provider in: resend | sendgrid | postmark | smtp2go | mailchannels
MAIL_PROVIDER=resend
MAIL_FROM=KOLKLI <verify@YOUR-DOMAIN.com>
MAIL_BRAND=KOLKLI
MAIL_API_KEY=

# --- Uploads --------------------------------------------------
# Max bytes per uploaded file (default 500MB, matching the paid plan).
MAX_FILE_BYTES=524288000

# --- Verification codes (email) -------------------------------
VERIFY_CODE_TTL_MIN=10
VERIFY_MAX_ATTEMPTS=5

# --- Scheduler ------------------------------------------------
# How often the expiry sweeper runs, in seconds (0 disables the timer).
EXPIRY_SWEEP_SEC=300
